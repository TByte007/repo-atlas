# Basic auth for non-LAN clients. LAN (10.0.0.0/8) is open.
# AuthUserFile must be the absolute path on the web server.
AuthType Basic
AuthName "repo-atlas"
AuthUserFile /home/tbyte/work/repo-atlas/.htpasswd

<RequireAny>
    Require ip 10.0.0.0/8
    Require valid-user
</RequireAny>

# http:// vhost has AllowOverride None — these rules apply on https:// only.
# Keep live secrets out of this tree (use ../repo-atlas-data).
<FilesMatch "^\.ht">
    Require all denied
</FilesMatch>

RedirectMatch 404 (?i)^/repo-atlas/\.git(/|$)
RedirectMatch 404 (?i)^/repo-atlas/(config|mirrors|cache|lib)(/|$)

DirectoryIndex index.php
